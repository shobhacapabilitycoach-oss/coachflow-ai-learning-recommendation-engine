    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const learner = $json.learners;\n\nconst quiz = Number(learner[\"Quiz Score (/100)\"]);\nconst roleplay = Number(learner[\"Role Play Score (/10)\"]);\nconst manager = Number(learner[\"Manager Feedback (/5)\"]);\n\nlet category = \"\";\n\nif (quiz < 60 || roleplay < 6 || manager < 3) {\n  category = \"Needs Immediate Support\";\n} else if (quiz <= 80 || roleplay <= 7 || manager === 3) {\n  category = \"Needs Reinforcement\";\n} else {\n  category = \"Performing Well\";\n}\n\nreturn {\n  json: {\n    ...learner,\n    learnerCategory: category\n  }\n};"
      },
